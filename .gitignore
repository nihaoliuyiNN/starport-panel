# 构建产物
/bin/
/dist/
*.exe
*.log
*.err

# 面板本地状态（--data-dir 非 Linux 默认值）
/data/
*.db
*.db-wal
*.db-shm

# 离线装机包（数百 MB，走 Release 附件 / 对象存储，不入库）
/scripts/dist/
*.tar.gz
*.tar.gz.sha256
*.part-*
*.parts.json

# 前端：源码在 web/，构建产物输出到 internal/panel/ui/dist（只保留 .gitkeep 占位）
/web/node_modules/
/web/dist/
/internal/panel/ui/dist/*
!/internal/panel/ui/dist/.gitkeep

# IDE / 本地
.idea/
.vscode/
.DS_Store
